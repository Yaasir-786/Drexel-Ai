# ---------- SERVER ----------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---------- DATABASE ----------
MONGO_URI=

# ---------- AUTH (JWT) ----------
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ---------- LLM (any OpenAI compatible provider: Groq, OpenRouter...) ----------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
PLANNER_MODEL=llama-3.1-8b-instant
CODER_MODEL=llama-3.3-70b-versatile
# optional: a vision model, only needed if users should attach images to prompts
VISION_MODEL=
CHAT_MAX_TOKENS=1500
PLANNER_MAX_TOKENS=1500
CODER_MAX_TOKENS=6000
REVIEW_MAX_TOKENS=4000
MAX_CONTEXT_CHARS=24000
REVIEW_MAX_INPUT_CHARS=20000

# ---------- CREDITS ----------
DEFAULT_CREDITS=200
CREDITS_PER_1K_TOKENS=1
DAILY_CREDIT_LIMIT=100
BUILD_MIN_CREDITS=10

# ---------- CLOUDINARY ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- EMAIL (forgot password) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---------- ADMIN (used by: npm run seed) ----------
ADMIN_EMAIL=admin@delux.ai
ADMIN_PASSWORD=
