PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d

# LLM provider (Google Gemini, OpenAI-compatible endpoint)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_api_key
PLANNER_MODEL=gemini-3.5-flash-lite
CODER_MODEL=gemini-3.6-flash
LLM_REASONING_EFFORT=medium
# Groq instead of Gemini: LLM_BASE_URL=https://api.groq.com/openai/v1
#   PLANNER_MODEL=llama-3.1-8b-instant
#   CODER_MODEL=llama-3.3-70b-versatile

# Optional limits
CHAT_MAX_TOKENS=4000
CHAT_REASONING_EFFORT=low
CODER_MAX_TOKENS=12000
REVIEW_MAX_TOKENS=8000
PLANNER_MAX_TOKENS=2000
MAX_CONTEXT_CHARS=24000

# Credits
DEFAULT_CREDITS=200
DAILY_CREDITS=100
DAILY_CREDIT_LIMIT=100
BUILD_MIN_CREDITS=10

# Admin (used by npm run seed)
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password

# Cloudinary (uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Images (Cloudflare Workers AI) + zip upload limit
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
IMAGE_MODEL=your_image_model
MAX_ZIP_MB=50
IMAGE_CREDITS=5
IMAGE_DAILY_LIMIT=10

# Image understanding (vision description only, same base url as the LLM provider)
VISION_MODEL=gemini-3.5-flash-lite
VISION_MAX_TOKENS=900
VISION_REASONING_EFFORT=low
